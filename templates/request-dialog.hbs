<form id="actor-request" class="pgt standard-form {{cssClass}}" style="min-width: 450px; max-width: 750px;">
  <h4 class="divider">{{#if awaitingResult}}{{localize "PGT.REQUEST.AWAITING_RESULT"}}{{else}}{{localize "PGT.REQUEST.SELECT_ACTORS"}}{{/if}}</h4>
  
  {{#if isRoll}} {{#unless awaitingResult}}
  {{#ifCond collectMode '!==' "preconfigured"}}
  <div class="form-group">
    <label>{{localize 'PGT.REQUEST.COLLECT_MODE'}}</label>
    <div class="form-fields">
      <select data-cType="collectMode">
        {{selectOptions collectModes selected=collectMode localize=true}}
      </select>
    </div>
    <a class="fa-solid fa-arrows-rotate" style="flex: 0;" data-tooltip="{{localize 'PGT.REQUEST.REFRESH'}}" data-action="refresh"></a>
  </div>
  {{/ifCond}}
  {{/unless}} {{/if}}

  <fieldset class="actor-wrapper box-wrapper scrollable">
  {{#if hasActors}} 
    {{#each actorSelector as |wrapper combinedKey|}}
    <div class="actor {{#if wrapper.selectable}}selectable{{/if}} {{#if wrapper.selected}}selected{{/if}} "
      {{#if wrapper.selectable}}data-cType="activable" data-path="actorSelector.{{combinedKey}}.selected"{{/if}}
    >
      {{#if wrapper.result}}<div class="roll-result-wrapper {{wrapper.outcome}}"><span class="roll-result" data-tooltip="{{localize "PGT.REQUEST.ROLL_RESULT"}}">{{wrapper.result}}</span></div>{{/if}}
      {{#if wrapper.request}} <div class="roll-result-wrapper awaiting-result"><span class="roll-result" data-tooltip="{{localize "PGT.REQUEST.AWAITING_RESULT"}}"><i class="fa-light fa-dice-d20 fa-lg dice-roll"></i></div></span>{{/if}}
      <img src="{{wrapper.actor.img}}"/>
      <input disabled value="{{wrapper.actor.name}}"  data-tooltip="{{wrapper.actor.name}}" />
      {{#if wrapper.key}}
      <div class="selected-roll-wrapper">
        <span class="selected-roll">
          {{#if wrapper.rollMode}}{{localize (concat "PGT.REQUEST." wrapper.rollMode)}}{{/if}}
          {{wrapper.label}}{{#if wrapper.rollDC}}{{localize "PGT.REQUEST.AGAINST_DC"}}{{wrapper.rollDC}}{{/if}}
        </span>
      </div>
      {{/if}}
    </div>
    {{/each}}
  {{else}}
    {{#unless awaitingResult}}
      {{#if isRoll}}
      <span>{{localize "PGT.REQUEST.NO_ACTOR.ROLL"}}</span>
      {{else}}
      <span>{{localize "PGT.REQUEST.NO_ACTOR.REST"}}</span>
      {{/if}}
    {{else}}
    <span>{{localize "PGT.REQUEST.NO_ACTOR.RESULT"}}</span>
    {{/unless}}
  {{/if}}
  </fieldset>

  {{!-- ROLL REQUEST --}}
  {{#if rollRequest}}
  <h4 class="divider">{{details.label}}</h4>

  <div class="form-group fixed-input" style="margin-top: 5px;">
    <label>{{localize "PGT.REQUEST.ROLL_DC"}}</label>
    <input type="number" data-path="details.rollDC" value="{{details.rollDC}}" data-cType="numeric-nullable"/>
  </div>

  {{!-- Progress Tracker --}}
  {{#if details.rollDC}} {{#if progressTrackers}}
  <div class="form-group">
    <label>{{localize "PGT.REQUEST.PROGRES_TRACKER"}}</label>
    <div class="form-fields">
      <select data-cType="string" data-path="details.tracker.key">
        {{selectOptions progressTrackers selected=details.tracker.key localize=true blank=""}}
      </select>
    </div>
  </div>

  {{#if details.tracker.key}}
  <div class="form-group">
    <label>{{localize "PGT.REQUEST.PROGRES_TRACKER_SUCCESS"}}</label>
    <div class="form-fields">
      <select data-cType="string" data-path="details.tracker.success">
        {{selectOptions progressTypes selected=details.tracker.success localize=true blank=""}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "PGT.REQUEST.PROGRES_TRACKER_FAIL"}}</label>
    <div class="form-fields">
      <select data-cType="string" data-path="details.tracker.fail">
        {{selectOptions progressTypes selected=details.tracker.fail localize=true blank=""}}
      </select>
    </div>
  </div>
  {{/if}}
  {{/if}} {{/if}}

  {{!-- Roll Mode --}}
  <div class="form-group">
    <label>{{localize "PGT.REQUEST.ROLL_MODE"}}</label>
    <div class="form-fields">
      <select data-cType="string" data-path="details.rollMode">
        {{selectOptions rollModes selected=details.rollMode localize=true blank=""}}
      </select>
    </div>
  </div>

  <div class="select-options-wrapper">
    {{#each selectOptions as |options category|}}
    <fieldset class="button-wrapper box-wrapper scrollable">
      <legend>{{localize (concat "PGT.CATEGORY." category)}}</legend>

      <div class="form-fields">
        <select data-cType="setRollRequest">
          <option value=""></option>
          {{#each options as |option key|}}
          <option value="{{key}}">{{option}}</option>
          {{/each}}
        </select>
      </div>
    </fieldset>
    {{/each}}
  </div>

  {{#unless awaitingResult}}
  <footer class="form-footer">
    <button class="button" data-action="sendRollRequest"><i class="fa-solid {{@root.details.icon}}"></i> {{localize "PGT.REQUEST.SEND_ROLL_REQUEST"}}</button>
  </footer>
  {{/unless}}
  {{/if}}

  {{#if awaitingResult}}
  <footer class="form-footer">
    <button class="button" data-action="close">{{localize "PGT.CLOSE"}}</button>
  </footer>
  {{/if}}

  {{!-- REST REQUEST --}}
  {{#if restRequest}}
  <h4 class="divider">{{details.label}}</h4>
    <fieldset class="button-wrapper box-wrapper scrollable">
      <legend>{{localize (concat "PGT.CATEGORY.REST_TYPE")}}</legend>

      {{#each selectOptions as |option key|}}
      <button class="option" {{#if @root.noActorSelected}}disabled{{/if}} data-action="sendRestRequest" data-key="{{key}}"><i class="fa-solid {{@root.details.icon}}"></i> <span>{{option}}</span></button>
      {{/each}}
    </fieldset>
  {{/if}}
</form>